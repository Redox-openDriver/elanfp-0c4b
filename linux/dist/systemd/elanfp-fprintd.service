[Unit]
Description=elanfp desktop bridge (net.reactivated.Fprint)
Documentation=file:///usr/local/share/doc/elanfp/README.md
Requires=elanfpd.service
After=elanfpd.service dbus.socket

[Service]
Type=dbus
BusName=net.reactivated.Fprint
ExecStart=/usr/local/bin/elanfp-fprintd
User=elanfp-fprint
Group=elanfp-fprint
Restart=always
RestartSec=2

UMask=0077
LimitCORE=0
MemorySwapMax=0
MemoryMax=256M
TasksMax=64
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
Alias=fprintd.service
