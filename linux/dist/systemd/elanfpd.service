[Unit]
Description=elanfp fingerprint service (ELAN 04f3:0c4b)
Documentation=file:///usr/local/share/doc/elanfp/README.md
After=systemd-udevd.service

[Service]
Type=exec
ExecStart=/usr/local/bin/elanfpd
User=elanfp
Group=elanfp
RuntimeDirectory=elanfp
RuntimeDirectoryMode=0755
StateDirectory=elanfp
StateDirectoryMode=0700
LoadCredentialEncrypted=elanfp-master:/etc/credstore.encrypted/elanfp-master
Restart=on-failure
RestartSec=2

UMask=0077
LimitCORE=0
MemorySwapMax=0
MemoryMax=512M
TasksMax=64
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
DevicePolicy=closed
DeviceAllow=char-usb_device rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
